import React from 'react';
import { NavigationContainer } from '@react-navigation/native';
import { createBottomTabNavigator } from '@react-navigation/bottom-tabs';
[[if use_typescript]]import { BottomTabNavigationOptions } from '@react-navigation/bottom-tabs';[[endif]]
[[for model in models]]
import [[model.pascal_name]]StackNavigator from './[[model.pascal_name]]StackNavigator';
[[endfor]]

const Tab = createBottomTabNavigator();

const MainNavigation = () => {
  return (
    <NavigationContainer>
      <Tab.Navigator>
        [[for model in models]]
        <Tab.Screen 
          name="[[model.pascal_name]]"
          component={[[model.pascal_name]]StackNavigator}
          options={{
            tabBarLabel: '[[model.name]]',
            // You can add custom icons here
          }}
        />
        [[endfor]]
      </Tab.Navigator>
    </NavigationContainer>
  );
};

export default MainNavigation;