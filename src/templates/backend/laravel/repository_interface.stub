<?php

namespace {{ namespace }};

use {{ model_namespace }}\{{ model_name }};
use Illuminate\Support\Collection;
use Illuminate\Pagination\LengthAwarePaginator;
use Illuminate\Http\UploadedFile;

interface {{ interface_name }}
{
    /**
     * Get all records.
     *
     * @return Collection
     */
    public function all(): Collection;

    /**
     * Get paginated records.
     *
     * @param int $perPage
     * @return LengthAwarePaginator
     */
    public function paginate(int $perPage = 15): LengthAwarePaginator;

    /**
     * Create a new record.
     *
     * @param array $data
     * @return {{ model_name }}
     */
    public function create(array $data): {{ model_name }};

    /**
     * Update an existing record.
     *
     * @param {{ model_name }} ${{ model_variable }}
     * @param array $data
     * @return bool
     */
    public function update({{ model_name }} ${{ model_variable }}, array $data);

    /**
     * Delete a record.
     *
     * @param {{ model_name }} ${{ model_variable }}
     * @return bool
     */
    public function delete({{ model_name }} ${{ model_variable }});

    /**
     * Find a record by its ID.
     *
     * @param int|string $id
     * @return {{ model_name }}|null
     */
    public function find($id): ?{{ model_name }};

    /**
     * Bulk import records from an Excel file.
     *
     * @param UploadedFile $file
     * @return array
     */
    public function bulkImport(UploadedFile $file);

    /**
     * Bulk export records to an Excel file.
     *
     * @return string The path to the exported file
     */
    public function bulkExport();

    {% if repo_type == 'Admin' %}
    /**
     * Get soft deleted records.
     *
     * @return Collection
     */
    public function getTrashed();

    /**
     * Restore a soft deleted record.
     *
     * @param int|string $id
     * @return bool
     */
    public function restore($id);
    {% endif %}

    {% if repo_type == 'CustomerWebsite' %}
    /**
     * Get featured records.
     *
     * @param int $limit
     * @return Collection
     */
    public function getFeatured(int $limit = 5);
    {% endif %}

    {% if repo_type == 'MobileApp' %}
    /**
     * Get records by location.
     *
     * @param float $latitude
     * @param float $longitude
     * @param float $radius
     * @return Collection
     */
    public function getByLocation(float $latitude, float $longitude, float $radius);
    {% endif %}
}