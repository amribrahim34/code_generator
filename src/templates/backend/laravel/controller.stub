<?php

namespace {{ namespace }};

use App\Http\Controllers\Controller;
use {{ model_namespace }}\{{ model_name }};
use {{ request_namespace }}\{{ request_class }};
use {{ resource_namespace }}\{{ resource_class }};
{% if use_repository %}
use {{ repository_namespace }}\{{ repository_interface }};
{% endif %}
use Illuminate\Http\Request;
use Illuminate\Http\Response;

/**
 * @OA\Tag(
 *     name="{{ model_plural }}",
 *     description="{{ model_name }} management"
 * )
 */
class {{ class_name }} extends Controller
{
    {% if use_repository %}
    protected ${{ model_variable }}Repository;

    public function __construct({{ repository_interface }} ${{ model_variable }}Repository)
    {
        $this->{{ model_variable }}Repository = ${{ model_variable }}Repository;
    }
    {% endif %}

    /**
     * @OA\Get(
     *     path="/api/{{ api_version }}/{{ controller_type_lower_case }}/{{ model_name_kebab }}",
     *     operationId="get{{ controller_type }}{{ model_name }}List",
     *     tags={"{{ model_plural }}"},
     *     summary="List all {{ model_plural }}",
     *     description="Returns a paginated list of {{ model_plural }}",
     *     @OA\Parameter(
     *         name="page",
     *         in="query",
     *         description="The page number",
     *         required=false,
     *         @OA\Schema(type="integer")
     *     ),
     *     @OA\Parameter(
     *         name="per_page",
     *         in="query",
     *         description="Number of items per page",
     *         required=false,
     *         @OA\Schema(type="integer")
     *     ),
     *     @OA\Response(
     *         response=200,
     *         description="Successful operation",
     *         @OA\JsonContent(
     *             type="object",
     *             @OA\Property(
     *                 property="data"
     *             ),
     *             @OA\Property(property="meta", ref="#/components/schemas/PaginationMeta")
     *         )
     *     )
     * )
     */
    public function index(Request $request)
    {
        $perPage = $request->input('per_page', 15);
        {% if use_repository %}
        ${{ model_plural }} = $this->{{ model_variable }}Repository->paginate($perPage);
        {% else %}
        ${{ model_plural }} = {{ model_name }}::paginate($perPage);
        {% endif %}
       
        return {{ resource_class }}::collection(${{ model_plural }});        
    }

    /**
     * @OA\Post(
     *     path="/api/{{ api_version }}/{{ controller_type_lower_case }}/{{ model_name_kebab }}",
     *     operationId="create{{ controller_type }}{{ model_name }}",
     *     tags={"{{ model_plural }}"},
     *     summary="Create a new {{ model_name }}",
     *     description="Creates a new {{ model_name }} and returns the created resource",
     *     @OA\RequestBody(
     *         required=true,
     *         @OA\JsonContent(ref="#/components/schemas/Store{{ request_class }}")
     *     ),
     *     @OA\Response(
     *         response=201,
     *         description="{{ model_name }} created successfully"
     *     )
     * )
     */
    public function store({{ request_class }} $request)
    {
        {% if use_repository %}
        ${{ model_variable }} = $this->{{ model_variable }}Repository->create($request->validated());
        {% else %}
        ${{ model_variable }} = {{ model_name }}::create($request->validated());
        {% endif %}
        
      
        return (new {{ resource_class }}(${{ model_variable }}))
            ->response()
            ->setStatusCode(Response::HTTP_CREATED);
    }

    /**
     * @OA\Get(
     *     path="/api/{{ api_version }}/{{ controller_type_lower_case }}/{{ model_name_kebab }}/{id}",
     *     operationId="get{{ controller_type }}{{ model_name }}",
     *     tags={"{{ model_plural }}"},
     *     summary="Get a specific {{ model_name }}",
     *     description="Returns a specific {{ model_name }}",
     *     @OA\Parameter(
     *         name="id",
     *         in="path",
     *         description="ID of {{ model_name }} to return",
     *         required=true,
     *         @OA\Schema(type="integer")
     *     ),
     *     @OA\Response(
     *         response=200,
     *         description="Successful operation"
     *     ),
     *     @OA\Response(
     *         response=404,
     *         description="{{ model_name }} not found"
     *     )
     * )
     */
    public function show($id)
    {
        {% if use_repository %}
        ${{ model_variable }} = $this->{{ model_variable }}Repository->findOrFail($id);
        {% else %}
        ${{ model_variable }} = {{ model_name }}::findOrFail($id);
        {% endif %}
        
        
        return new {{ resource_class }}(${{ model_variable }});
    }

    /**
     * @OA\Put(
     *     path="/api/{{ api_version }}/{{ controller_type_lower_case }}/{{ model_name_kebab }}/{id}",
     *     operationId="Update{{ controller_type }}{{ model_name }}",
     *     tags={"{{ model_plural }}"},
     *     summary="Update a {{ model_name }}",
     *     description="Updates a {{ model_name }} and returns the updated resource",
     *     @OA\Parameter(
     *         name="id",
     *         in="path",
     *         description="ID of {{ model_name }} to update",
     *         required=true,
     *         @OA\Schema(type="integer")
     *     ),
     *     @OA\RequestBody(
     *         required=true,
     *         @OA\JsonContent(ref="#/components/schemas/Update{{ request_class }}")
     *     ),
     *     @OA\Response(
     *         response=200,
     *         description="{{ model_name }} updated successfully"
     *     ),
     *     @OA\Response(
     *         response=404,
     *         description="{{ model_name }} not found"
     *     )
     * )
     */
    public function update({{ request_class }} $request, $id)
    {
        {% if use_repository %}
        ${{ model_variable }} = $this->{{ model_variable }}Repository->update($id, $request->validated());
        {% else %}
        ${{ model_variable }} = {{ model_name }}::findOrFail($id);
        ${{ model_variable }}->update($request->validated());
        {% endif %}
        

        return new {{ resource_class }}(${{ model_variable }});
    }

    /**
     * @OA\Delete(
     *     path="/api/{{ api_version }}/{{ controller_type_lower_case }}/{{ model_name_kebab }}/{id}",
     *     operationId="delete{{ controller_type }}{{ model_name }}",
     *     tags={"{{ model_plural }}"},
     *     summary="Delete a {{ model_name }}",
     *     description="Deletes a {{ model_name }}",
     *     @OA\Parameter(
     *         name="id",
     *         in="path",
     *         description="ID of {{ model_name }} to delete",
     *         required=true,
     *         @OA\Schema(type="integer")
     *     ),
     *     @OA\Response(
     *         response=204,
     *         description="{{ model_name }} deleted successfully"
     *     ),
     *     @OA\Response(
     *         response=404,
     *         description="{{ model_name }} not found"
     *     )
     * )
     */
    public function destroy($id)
    {
        {% if use_repository %}
        $this->{{ model_variable }}Repository->delete($id);
        {% else %}
        ${{ model_variable }} = {{ model_name }}::findOrFail($id);
        ${{ model_variable }}->delete();
        {% endif %}
        
        
        return response()->noContent();
    }

    /**
    * @OA\Post(
    *     path="/api/{{ api_version }}/{{ controller_type_lower_case }}/{{ model_name_kebab }}/bulk-import",
    *     operationId="bulkImport{{ controller_type }}{{ model_name }}",
    *     tags={"{{ model_plural }}"},
    *     summary="Bulk import {{ model_plural }}",
    *     description="Imports multiple {{ model_plural }} at once",
    *     @OA\RequestBody(
    *         required=true
    *     ),
    *     @OA\Response(
    *         response=201,
    *         description="{{ model_plural }} imported successfully"
    *     )
    * )
    */
   public function bulkImport(Request $request)
   {
       {% if use_repository %}
       ${{ model_plural }} = $this->{{ model_variable }}Repository->bulkCreate($request->all());
       {% else %}
       ${{ model_plural }} = {{ model_name }}::insert($request->all());
       {% endif %}
       return {{ resource_class }}::collection(${{ model_plural }});
   }

   /**
    * @OA\Put(
    *     path="/api/{{ api_version }}/{{ controller_type_lower_case }}/{{ model_name_kebab }}/bulk-update",
    *     operationId="bulkUpdate{{ controller_type }}{{ model_name }}",
    *     tags={"{{ model_plural }}"},
    *     summary="Bulk update {{ model_plural }}",
    *     description="Updates multiple {{ model_plural }} at once",
    *     @OA\RequestBody(
    *         required=true
    *     ),
    *     @OA\Response(
    *         response=200,
    *         description="{{ model_plural }} updated successfully"
    *     )
    * )
    */
   public function bulkUpdate(Request $request)
   {
       {% if use_repository %}
       ${{ model_plural }} = $this->{{ model_variable }}Repository->bulkUpdate($request->all());
       {% else %}
       ${{ model_plural }} = collect($request->all())->map(function ($item) {
           ${{ model_variable }} = {{ model_name }}::findOrFail($item['id']);
           ${{ model_variable }}->update($item);
           return ${{ model_variable }};
       });
       {% endif %}
       return {{ resource_class }}::collection(${{ model_plural }});
   }

   /**
    * @OA\Delete(
    *     path="/api/{{ api_version }}/{{ controller_type_lower_case }}/{{ model_name_kebab }}/bulk-delete",
    *     operationId="bulkDelete{{ controller_type }}{{ model_name }}",
    *     tags={"{{ model_plural }}"},
    *     summary="Bulk delete {{ model_plural }}",
    *     description="Deletes multiple {{ model_plural }} at once",
    *     @OA\RequestBody(
    *         required=true,
    *         @OA\JsonContent(
    *             type="array",
    *             @OA\Items(type="integer")
    *         )
    *     ),
    *     @OA\Response(
    *         response=204,
    *         description="{{ model_plural }} deleted successfully"
    *     )
    * )
    */
   public function bulkDelete(Request $request)
   {
       {% if use_repository %}
       $this->{{ model_variable }}Repository->bulkDelete($request->all());
       {% else %}
       {{ model_name }}::whereIn('id', $request->all())->delete();
       {% endif %}
       return response()->noContent();
   }

   // Additional methods specific to {{ controller_type }} controller
   {% if controller_type == 'Admin' %}
   /**
    * @OA\Get(
    *     path="/api/{{ api_version }}/{{ controller_type_lower_case }}/{{ model_name_kebab }}/export",
    *     operationId="export{{ controller_type }}{{ model_name }}",
    *     tags={"{{ model_plural }}"},
    *     summary="Export {{ model_plural }} data",
    *     description="Exports {{ model_plural }} data to a file",
    *     @OA\Response(
    *         response=200,
    *         description="Exported {{ model_plural }} data",
    *         @OA\Header(
    *             header="Content-Disposition",
    *             description="attachment; filename={{ model_plural }}.csv",
    *             @OA\Schema(type="string")
    *         ),
    *         @OA\MediaType(
    *             mediaType="text/csv",
    *             @OA\Schema(type="string")
    *         )
    *     )
    * )
    */
   public function export()
   {
       // Implementation for exporting {{ model_plural }}
       {% if use_repository %}
       ${{ model_plural }} = $this->{{ model_variable }}Repository->all();
       {% else %}
       ${{ model_plural }} = {{ model_name }}::all();
       {% endif %}
       // Add logic to convert ${{ model_plural }} to CSV and return as a download
   }
   {% endif %}

   {% if controller_type == 'Website' %}
   /**
    * @OA\Get(
    *     path="/api/{{ api_version }}/{{ controller_type_lower_case }}/{{ model_name_kebab }}/featured",
    *     operationId="getFeatured{{ controller_type }}{{ model_name }}",
    *     tags={"{{ model_plural }}"},
    *     summary="Get featured {{ model_plural }}",
    *     description="Returns a list of featured {{ model_plural }}",
    *     @OA\Response(
    *         response=200,
    *         description="Successful operation"
    *     )
    * )
    */
   public function featured()
   {
       {% if use_repository %}
       $featured{{ model_plural }} = $this->{{ model_variable }}Repository->getFeatured();
       {% else %}
       $featured{{ model_plural }} = {{ model_name }}::where('is_featured', true)->get();
       {% endif %}
       return {{ resource_class }}::collection($featured{{ model_plural }});
   }
   {% endif %}

   {% if controller_type == 'MobileApp' %}
   /**
    * @OA\Get(
    *     path="/api/{{ api_version }}/{{ controller_type_lower_case }}/{{ model_name_kebab }}/nearby",
    *     operationId="getNearby{{ controller_type }}{{ model_name }}",
    *     tags={"{{ model_plural }}"},
    *     summary="Get nearby {{ model_plural }}",
    *     description="Returns a list of nearby {{ model_plural }} based on provided coordinates",
    *     @OA\Parameter(
    *         name="latitude",
    *         in="query",
    *         description="Latitude of the center point",
    *         required=true,
    *         @OA\Schema(type="number", format="float")
    *     ),
    *     @OA\Parameter(
    *         name="longitude",
    *         in="query",
    *         description="Longitude of the center point",
    *         required=true,
    *         @OA\Schema(type="number", format="float")
    *     ),
    *     @OA\Parameter(
    *         name="radius",
    *         in="query",
    *         description="Search radius in kilometers",
    *         required=false,
    *         @OA\Schema(type="number", format="float", default=10)
    *     ),
    *     @OA\Response(
    *         response=200,
    *         description="Successful operation"
    *     )
    * )
    */
   public function nearby(Request $request)
   {
       $latitude = $request->input('latitude');
       $longitude = $request->input('longitude');
       $radius = $request->input('radius', 10); // Default radius of 10 km if not provided

       {% if use_repository %}
       $nearbyItems = $this->{{ model_variable }}Repository->getNearby($latitude, $longitude, $radius);
       {% else %}
       // This is a simplified example. You might need to adjust this based on your database and requirements
       $nearbyItems = {{ model_name }}::selectRaw("*, 
           ( 6371 * acos( cos( radians(?) ) *
               cos( radians( latitude ) )
               * cos( radians( longitude ) - radians(?)
               ) + sin( radians(?) ) *
               sin( radians( latitude ) )
           )
           ) AS distance", [$latitude, $longitude, $latitude])
           ->having("distance", "<", $radius)
           ->orderBy("distance")
           ->get();
       {% endif %}
       return {{ resource_class }}::collection($nearbyItems);
   }
   {% endif %}
 }