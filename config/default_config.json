{
  "project": {
    "name": "LaravelVueGenerator",
    "version": "2.0.0",
    "description": "Advanced code generator for Laravel backend and Vue.js frontend"
  },
  "output": {
    "base_directory": "./output",
    "backend_directory": "backend",
    "frontend_directory": "frontend",
    "api_docs_directory": "api-docs"
  },
  "indent": {
    "size": 4,
    "style": "space"
  },
  "naming": {
    "model": "PascalCase",
    "controller": "PascalCase",
    "migration": "snake_case",
    "table": "snake_case",
    "component": "PascalCase",
    "store": "camelCase",
    "route": "kebab-case"
  },

  "frontend": {
    "framework": "vue",
    "version": "3.x",
    "use_typescript": true,
    "use_composition_api": true,
    "output_dir": "admin",
    "route_dir": "routes",
    "store_dir": "stores",
    "type_dir": "types",
    "state_management": "pinia",
    "ui_framework": "primevue",
    "component_structure": {
      "components": "src/components",
      "views": "src/views",
      "store": "src/store",
      "router": "src/router",
      "types": "src/types",
      "assets": "src/assets",
      "layouts": "src/layouts"
    }
  },

  "database": {
    "engine": "mysql",
    "charset": "utf8mb4",
    "collation": "utf8mb4_unicode_ci",
    "use_uuid": false,
    "use_soft_deletes": true
  },
  "api": {
    "version": "v1",
    "prefix": "api",
    "documentation": {
      "type": "swagger",
      "auto_generate": true
    }
  },
  "generators": {
    "backend": [
      {
        "name": "model",
        "module": "src.generators.backend.laravel.model_generator",
        "class": "ModelGenerator"
      },
      {
        "name": "migration",
        "module": "src.generators.backend.laravel.migration_generator",
        "class": "MigrationGenerator"
      },
      {
        "name": "middleware",
        "module": "src.generators.backend.laravel.middleware_generator",
        "class": "MiddlewareGenerator"
      },
      {
        "name": "controller",
        "module": "src.generators.backend.laravel.controller_generator",
        "class": "ControllerGenerator"
      },
      {
        "name": "route",
        "module": "src.generators.backend.laravel.route_generator",
        "class": "RouteGenerator"
      },
      {
        "name": "request",
        "module": "src.generators.backend.laravel.request_generator",
        "class": "RequestGenerator"
      },
      {
        "name": "factory",
        "module": "src.generators.backend.laravel.factory_generator",
        "class": "FactoryGenerator"
      },
      {
        "name": "seeder",
        "module": "src.generators.backend.laravel.seeder_generator",
        "class": "SeederGenerator"
      },
      {
        "name": "observer",
        "module": "src.generators.backend.laravel.observer_generator",
        "class": "ObserverGenerator"
      },
      {
        "name": "event",
        "module": "src.generators.backend.laravel.event_generator",
        "class": "EventGenerator"
      },
      {
        "name": "listener",
        "module": "src.generators.backend.laravel.listener_generator",
        "class": "ListenerGenerator"
      },
      {
        "name": "job",
        "module": "src.generators.backend.laravel.job_generator",
        "class": "JobGenerator"
      },
      {
        "name": "notification",
        "module": "src.generators.backend.laravel.notification_generator",
        "class": "NotificationGenerator"
      },
      {
        "name": "mail",
        "module": "src.generators.backend.laravel.mail_generator",
        "class": "MailGenerator"
      },
      {
        "name": "test",
        "module": "src.generators.backend.laravel.unit_test_generator",
        "class": "TestGenerator"
      },
      {
        "name": "repository",
        "module": "src.generators.backend.laravel.repository_generator",
        "class": "RepositoryGenerator"
      },
      {
        "name": "repository_interface",
        "module": "src.generators.backend.laravel.repository_interface_generator",
        "class": "RepositoryInterfaceGenerator"
      },
      {
        "name": "service",
        "module": "src.generators.backend.laravel.service_generator",
        "class": "ServiceGenerator"
      },
      {
        "name": "trait",
        "module": "src.generators.backend.laravel.trait_generator",
        "class": "TraitGenerator"
      },
      {
        "name": "resource",
        "module": "src.generators.backend.laravel.resource_generator",
        "class": "ResourceGenerator"
      }
    ],
    "frontend": [
      {
        "name": "router",
        "module": "src.generators.frontend.vue.router_generator",
        "class": "RouterGenerator"
      },
      {
        "name": "type",
        "module": "src.generators.frontend.vue.type_generator",
        "class": "TypeGenerator"
      },
      {
        "name": "component",
        "module": "src.generators.frontend.vue.component_generator",
        "class": "ComponentGenerator"
      },
      {
        "name": "store",
        "module": "src.generators.frontend.vue.store_generator",
        "class": "StoreGenerator"
      }
    ],
    "react_native": [
      {
        "name": "component",
        "module": "src.generators.mobile.react_native.component_generator",
        "class": "ComponentGenerator"
      },
      {
        "name": "screen",
        "module": "src.generators.mobile.react_native.screen_generator",
        "class": "ScreenGenerator"
      },
      {
        "name": "navigation",
        "module": "src.generators.mobile.react_native.navigation_generator",
        "class": "NavigationGenerator"
      },
      {
        "name": "store",
        "module": "src.generators.mobile.react_native.store_generator",
        "class": "StoreGenerator"
      }
    ]
  },
  "code_style": {
    "psr_standards": true,
    "use_type_hints": true,
    "use_return_types": true,
    "use_docblocks": true
  },
  "security": {
    "hash_user_passwords": true,
    "use_csrf_protection": true,
    "use_xss_protection": true,
    "use_sql_injection_protection": true
  },
  "performance": {
    "use_eager_loading": true,
    "use_lazy_loading": true,
    "use_query_caching": true
  },
  "deployment": {
    "use_docker": false,
    "use_ci_cd": false,
    "preferred_hosting": "heroku"
  }
}
